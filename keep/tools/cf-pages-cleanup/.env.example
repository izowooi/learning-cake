# Cloudflare Pages Cleanup 환경 설정
# 이 파일을 .env로 복사하고 필요한 값을 설정하세요

# Cloudflare API 토큰 (필수)
# https://dash.cloudflare.com/profile/api-tokens 에서 생성
# 필요한 권한: Account - Cloudflare Pages - Edit
CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare 계정 ID (필수)
# Cloudflare 대시보드 우측 사이드바에서 확인 가능
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
